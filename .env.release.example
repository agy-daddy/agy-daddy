# Agy-Daddy 发布环境配置模板（切勿提交包含真实密钥的 .env.release.local）
#
# 环境隔离矩阵:
# - development: 本地调试 / 干跑预演 (dist-tag: dev)
# - staging:     金丝雀 / 预发布通道 (dist-tag: next)
# - production:  正式生产通道       (dist-tag: latest)

# 目标环境: development | staging | production
RELEASE_ENV=staging

# 目标 npm Registry 地址（本地 Verdaccio 联调可改为 http://127.0.0.1:4873）
NPM_REGISTRY_URL=https://registry.npmjs.org

# 可选覆写 dist-tag；留空时按 RELEASE_ENV 自动映射 (dev / next / latest)
NPM_DIST_TAG=

# npm 发布凭证（CI 中由 GitHub Secrets NPM_TOKEN 注入；本地推荐使用 Granular Access Token 或 OIDC）
NODE_AUTH_TOKEN=

# 前端静态资源公共基础路径（CDN/OSS 子路径注入，如 https://cdn.example.com/agy-daddy/；留空回退为本地 /）
VITE_PUBLIC_BASE=/

# 是否生成独立 Sourcemap（true | false；默认 false 避免源码泄露）
VITE_SOURCEMAP=false

# 可选：发布结果告警 Webhook URL（通用 JSON POST，如飞书/钉钉/Slack Webhook）
AGY_DADDY_ALERT_WEBHOOK_URL=
