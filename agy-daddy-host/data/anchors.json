        {
          "range": ">=2.0.0",
          "selectors": [
            "[class*=\"@container/titlebar\"] > div.shrink-0",
            "[data-testid=\"toggle-aux-sidebar\"]",
            "div.h-screen.w-screen > div.flex-1 > div.absolute.right-0.z-50",
            "div.absolute.right-0.top-0.z-50"
          ],
          "closestHint": "div.absolute.right-0"
        },
        {
          "range": ">=1.0.0 <2.0.0",
          "selectors": [
            "div.absolute.right-0.top-0.z-50",
            "[data-testid=\"toggle-aux-sidebar\"]"
          ]
        }
      ]
    },
    "composer.root": {
      "description": "对话输入框根容器与底部操作区",
