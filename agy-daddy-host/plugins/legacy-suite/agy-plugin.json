{
  "schemaVersion": 1,
  "id": "agy-daddy.legacy-suite",
  "publisher": "agy-daddy",
  "version": "1.0.0",
  "license": "MIT",
  "displayName": {
    "zh-CN": "Legacy Suite 兼容插件",
    "en": "Legacy Suite Compatibility Bridge"
  },
  "engines": {
    "agyDaddy": "^1.0.0",
    "antigravity": ">=2.32.0"
  },
  "main": "./src/node.js",
  "renderer": "./src/renderer.js",
  "world": "main",
  "activationEvents": ["onStartup"],
  "requires": {
    "anchors": ["topbar.rightCluster"]
  },
  "provides": {
    "services": {
      "legacy-suite": { "version": "1.0.0", "realm": "node" }
    }
  },
  "permissions": [
    "dom:read",
    "dom:write",
    "page:main-world",
    "rpc:read",
    "rpc:write",
    "bridge:route",
    "fs:brain-read",
    "fs:user-files",
    "net:listen",
    "net:outbound:*",
    "process:spawn",
    "host:launch-args"
  ],
  "contributes": {
    "settings": { "schema": "./settings.schema.json" }
  }
}
