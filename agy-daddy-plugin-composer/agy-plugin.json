{
  "schemaVersion": 1,
  "id": "agy-daddy.composer",
  "publisher": "agy-daddy",
  "version": "1.1.1",
  "license": "MIT",
  "displayName": {
    "zh-CN": "输入框增强",
    "en": "Composer Quick Bar & Guard"
  },
  "description": {
    "zh-CN": "输入框快捷指令栏、提示词一键优化与撤回、Tab 下一步幽灵建议与高危命令拦截",
    "en": "Composer quick prompts bar, prompt optimizer with undo, ghost follow-ups, and high-risk Auto-Accept guard"
  },
  "engines": {
    "agyDaddy": "^1.0.0",
    "antigravity": ">=2.32.0"
  },
  "main": "./src/node.js",
  "renderer": "./src/renderer.js",
  "world": "isolated",
  "activationEvents": ["onStartup"],
  "requires": {
    "anchors": ["composer.root", "composer.editor", "composer.sendButton", "chat.actionButtons"]
  },
  "provides": {
    "services": {
      "composer": { "version": "1.0.0", "realm": "page-isolated" },
      "composer-node": { "version": "1.0.0", "realm": "node" }
    },
    "surfaces": ["composer.quickActions"],
    "events": ["composer:high-risk-detected@1"]
  },
  "consumes": {
    "context": { "version": "^1.0.0", "optional": true }
  },
  "permissions": [
    "dom:read",
    "dom:write",
    "rpc:read",
    "rpc:write",
    "bridge:route",
    "native:install"
  ],
  "contributes": {
    "settings": { "schema": "./settings.schema.json" },
    "commands": [
      { "id": "composer.compact", "title": { "zh-CN": "发送 /compact 压缩指令", "en": "Send /compact" } },
      { "id": "composer.listFrequentPrompts", "title": { "zh-CN": "读取历史高频快捷指令列表", "en": "List Frequent Prompts" } },
      { "id": "composer.summarizeFrequentPrompts", "title": { "zh-CN": "手动总结高频手动发送词", "en": "Summarize Frequent Manual Prompts" } }
    ],
    "locales": "./locales",
    "native": {
      "rules": ["./native/fast-io-AGENTS.md"]
    }
  }
}
