{
  "schemaVersion": 1,
  "id": "agy-daddy.context",
  "publisher": "agy-daddy",
  "version": "1.1.0",
  "license": "MIT",
  "displayName": {
    "zh-CN": "上下文与实时速度",
    "en": "Context & Live Speed"
  },
  "description": {
    "zh-CN": "当前对话实时状态面板与单点胶囊（上下文窗口、本对话累计 Token 与实时生成速度，顶栏或输入框下方二选一）",
    "en": "Real-time current conversation monitor (context window, session tokens, live tok/s speed) with exclusive composer or topbar placement"
  },
  "engines": {
    "agyDaddy": "^1.0.0",
    "antigravity": ">=2.32.0"
  },
  "main": "./src/node.js",
  "renderer": "./src/renderer.js",
  "world": "isolated",
  "activationEvents": ["onStartup"],
  "requires": {
    "anchors": ["topbar.rightCluster", "composer.root"]
  },
  "provides": {
    "services": {
      "context": { "version": "1.0.0", "realm": "node" },
      "context-ui": { "version": "1.0.0", "realm": "page-isolated" }
    },
    "events": ["telemetry:generator-calls@1", "context:auto-compact-triggered@1"],
    "states": ["state:context.snapshot@1"]
  },
  "consumes": {
    "usage": { "version": "^1.0.0", "optional": true }
  },
  "permissions": [
    "dom:read",
    "dom:write",
    "rpc:read",
    "fs:brain-read",
    "bridge:route",
    "native:install"
  ],
  "contributes": {
    "topbar.units": [{ "id": "ring", "order": 10 }],
    "topbar.popovers": [{ "id": "context-panel", "anchorId": "ring" }],
    "settings": { "schema": "./settings.schema.json" },
    "remote.panels": [{ "id": "context", "service": "context" }],
    "commands": [
      { "id": "context.rescan", "title": { "zh-CN": "重新扫描会话", "en": "Rescan session" } }
    ],
    "native": {
      "mcp": "./native/mcp.json",
      "skills": ["./native/skills"]
    },
    "locales": "./locales"
  }
}
