{
  "schemaVersion": 1,
  "id": "agy-daddy.context",
  "publisher": "agy-daddy",
  "version": "1.0.0",
  "license": "MIT",
  "displayName": {
    "zh-CN": "上下文胶囊与面板",
    "en": "Context Capsule & Panel"
  },
  "engines": {
    "agyDaddy": "^1.0.0",
    "antigravity": ">=2.32.0"
  },
  "main": "./src/node.js",
  "renderer": "./src/renderer.js",
  "world": "main",
  "activationEvents": ["onStartup"],
  "requires": {
    "anchors": ["topbar.rightCluster", "composer.root"]
  },
  "provides": {
    "services": {
      "context": { "version": "1.0.0", "realm": "node" },
      "context-ui": { "version": "1.0.0", "realm": "page-main" }
    },
    "events": ["telemetry:generator-calls@1"],
    "states": ["state:context.snapshot@1"]
  },
  "consumes": {
    "usage": { "version": "^1.0.0", "optional": true }
  },
  "permissions": [
    "dom:read",
    "dom:write",
    "page:main-world",
    "rpc:read",
    "fs:brain-read",
    "bridge:route",
    "native:install"
  ],
  "contributes": {
    "topbar.units": [{ "id": "ring", "order": 10 }],
    "topbar.popovers": [{ "id": "context-panel", "anchorId": "ring" }],
    "settings": { "schema": "./settings.schema.json" },
    "remote.panels": [{ "id": "context", "service": "context" }],
    "commands": [
      { "id": "context.rescan", "title": { "zh-CN": "重新扫描会话", "en": "Rescan session" } }
    ],
    "native": {
      "mcp": "./native/mcp.json",
      "skills": ["./native/skills"]
    },
    "locales": "./locales",
    "migrations": [
      { "from": "AntigravityContextMeter", "files": ["settings.json#context"] }
    ]
  }
}
