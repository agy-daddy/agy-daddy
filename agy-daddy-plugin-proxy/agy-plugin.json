{
  "schemaVersion": 1,
  "id": "agy-daddy.proxy",
  "publisher": "agy-daddy",
  "version": "1.0.0",
  "license": "MIT",
  "displayName": {
    "zh-CN": "免重启网络代理网关",
    "en": "Hot-Switch Proxy Gateway"
  },
  "engines": {
    "agyDaddy": "^1.0.0",
    "antigravity": ">=2.32.0"
  },
  "main": "./src/node.js",
  "renderer": "./src/renderer.js",
  "world": "isolated",
  "activationEvents": ["onStartup"],
  "provides": {
    "services": {
      "proxy": { "version": "1.0.0", "realm": "node" }
    },
    "events": ["proxy:config-changed@1"],
    "states": ["state:proxy.status@1"]
  },
  "permissions": [
    "dom:write",
    "bridge:route",
    "net:listen",
    "net:outbound:*",
    "host:launch-args"
  ],
  "contributes": {
    "topbar.units": [{ "id": "proxy-badge", "order": 85 }],
    "settings": { "schema": "./settings.schema.json" },
    "commands": [
      { "id": "proxy.switch-mode", "title": { "zh-CN": "切换代理模式", "en": "Switch proxy mode" } },
      { "id": "proxy.probe", "title": { "zh-CN": "探测代理连通性", "en": "Probe proxy connectivity" } }
    ],
    "locales": "./locales",
    "migrations": [
      { "from": "AntigravityContextMeter", "files": ["modules.json#proxy", "proxy.json"] }
    ]
  }
}
