{
  "schemaVersion": 1,
  "id": "agy-daddy.quota",
  "publisher": "agy-daddy",
  "version": "1.0.0",
  "license": "MIT",
  "displayName": {
    "zh-CN": "额度监控",
    "en": "Quota Monitor"
  },
  "description": {
    "zh-CN": "顶栏 Gemini/Claude 配额双池胶囊与 5h/周倒计时详情浮窗",
    "en": "Topbar Gemini/Claude dual-pool quota capsule and 5h/weekly reset countdown popover"
  },
  "engines": {
    "agyDaddy": "^1.0.0",
    "antigravity": ">=2.32.0"
  },
  "main": "./src/node.js",
  "renderer": "./src/renderer.js",
  "world": "isolated",
  "activationEvents": ["onStartup"],
  "requires": {
    "anchors": ["topbar.rightCluster"]
  },
  "provides": {
    "services": {
      "quota": { "version": "1.0.0", "realm": "node" }
    },
    "states": ["state:quota.snapshot@1"]
  },
  "consumes": {
    "subscription": { "version": "^1.0.0", "optional": true }
  },
  "permissions": [
    "dom:write",
    "rpc:read",
    "bridge:route",
    "native:install"
  ],
  "contributes": {
    "topbar.units": [{ "id": "quota", "order": 30 }],
    "topbar.popovers": [{ "id": "quota-panel", "anchorId": "quota" }],
    "settings": { "schema": "./settings.schema.json" },
    "remote.panels": [{ "id": "quota", "service": "quota" }],
    "native": {
      "mcp": "./native/mcp.json"
    },
    "locales": "./locales"
  }
}
