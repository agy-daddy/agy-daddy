{
  "schemaVersion": 1,
  "id": "agy-daddy.remote",
  "publisher": "agy-daddy",
  "version": "1.0.0",
  "license": "MIT",
  "displayName": {
    "zh-CN": "手机远程控制台",
    "en": "Mobile Remote Console"
  },
  "engines": {
    "agyDaddy": "^1.0.0",
    "antigravity": ">=2.32.0"
  },
  "main": "./src/node.js",
  "renderer": "./src/renderer.js",
  "remote": "./src/remote-client.js",
  "world": "main",
  "activationEvents": ["onStartup"],
  "requires": {
    "anchors": ["topbar.rightCluster"]
  },
  "provides": {
    "services": {
      "remote": { "version": "1.0.0", "realm": "node" }
    },
    "surfaces": ["remote.panels", "remote.actions"],
    "states": ["state:remote.status@1"]
  },
  "consumes": {
    "context": { "version": "^1.0.0", "optional": true },
    "usage": { "version": "^1.0.0", "optional": true },
    "quota": { "version": "^1.0.0", "optional": true }
  },
  "permissions": [
    "dom:write",
    "page:main-world",
    "rpc:read",
    "rpc:write",
    "bridge:route",
    "net:listen",
    "process:spawn"
  ],
  "contributes": {
    "topbar.units": [{ "id": "remote", "order": 60 }],
    "topbar.popovers": [{ "id": "remote-panel", "anchorId": "remote" }],
    "settings": { "schema": "./settings.schema.json" },
    "commands": [
      { "id": "remote.rotate-token", "title": { "zh-CN": "轮换远程配对令牌", "en": "Rotate Mobile Pairing Token" } },
      { "id": "remote.status", "title": { "zh-CN": "查看远程通道状态", "en": "Check Remote Channel Status" } }
    ],
    "locales": "./locales",
    "migrations": [
      { "from": "AntigravityContextMeter", "files": ["remote-config.json", "remote-tunnel-state.json"] }
    ]
  }
}
