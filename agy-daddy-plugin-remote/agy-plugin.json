{
  "schemaVersion": 1,
  "id": "agy-daddy.remote",
  "publisher": "agy-daddy",
  "version": "1.1.1",
  "license": "MIT",
  "displayName": {
    "zh-CN": "远程访问",
    "en": "Remote Access"
  },
  "description": {
    "zh-CN": "18765 手机极速 PWA 服务、四通道/Cloudflare 隧道与顶栏扫码浮窗",
    "en": "Mobile PWA console on port 18765 with multi-channel/Cloudflare tunnels and topbar QR pairing popover"
  },
  "engines": {
    "agyDaddy": "^1.0.0",
    "antigravity": ">=2.32.0"
  },
  "main": "./src/node.js",
  "renderer": "./src/renderer.js",
  "remote": "./src/remote-client.js",
  "world": "isolated",
  "activationEvents": ["onStartup"],
  "requires": {
    "anchors": ["topbar.rightCluster"]
  },
  "provides": {
    "services": {
      "remote": { "version": "1.0.0", "realm": "node" }
    },
    "surfaces": ["remote.panels", "remote.actions"],
    "states": ["state:remote.status@1"]
  },
  "consumes": {
    "context": { "version": "^1.0.0", "optional": true },
    "usage": { "version": "^1.0.0", "optional": true },
    "quota": { "version": "^1.0.0", "optional": true },
    "web-harness": { "version": "^1.0.0", "optional": true },
    "composer-node": { "version": "^1.0.0", "optional": true }
  },
  "permissions": [
    "dom:write",
    "rpc:read",
    "rpc:write",
    "bridge:route",
    "fs:brain-read",
    "fs:user-files",
    "net:listen",
    "process:spawn"
  ],
  "contributes": {
    "topbar.units": [{ "id": "remote", "order": 60 }],
    "topbar.popovers": [{ "id": "remote-panel", "anchorId": "remote" }],
    "settings": { "schema": "./settings.schema.json" },
    "commands": [
      { "id": "remote.rotate-token", "title": { "zh-CN": "轮换远程配对令牌", "en": "Rotate Mobile Pairing Token" } },
      { "id": "remote.status", "title": { "zh-CN": "查看远程通道状态", "en": "Check Remote Channel Status" } },
      { "id": "remote.kick-devices", "title": { "zh-CN": "踢出全部已连设备并轮换令牌", "en": "Disconnect All Devices & Rotate Token" } },
      { "id": "remote.check-cloudflared", "title": { "zh-CN": "检测 cloudflared 安装状态", "en": "Check cloudflared Installation" } },
      { "id": "remote.browse-allowed-root", "title": { "zh-CN": "浏览并添加允许访问的工作区目录", "en": "Browse Allowed Workspace Root Directory" } },
      { "id": "remote.list-models", "title": { "zh-CN": "获取可用模型列表", "en": "List Available Models" } }
    ],
    "locales": "./locales"
  }
}
