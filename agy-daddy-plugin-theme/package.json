  "description": "Independent opt-in visual theme & optical preset plugin for Agy-Daddy with component-level customization, code highlight themes, and optional motion/afterglow controls",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/agy-daddy/agy-daddy.git",
    "directory": "agy-daddy-plugin-theme"
  },
  "main": "./src/node.js",
  "agyPlugin": "./agy-plugin.json",
  "files": [
    "agy-plugin.json",
    "settings.schema.json",
    "src/",
    "locales/",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node -e \"const cp=require('node:child_process'),fs=require('node:fs'),p=require('node:path');const files=fs.readdirSync('test').filter(f=>f.endsWith('.test.js')).sort().map(f=>p.join('test',f));process.exit(cp.spawnSync(process.execPath,['--test',...files],{stdio:'inherit',env:{...process.env,AGY_DADDY_TEST_MODE:'1'}}).status??1)\""
  },
  "engines": {
    "node": ">=22.4.0"
  }
}
