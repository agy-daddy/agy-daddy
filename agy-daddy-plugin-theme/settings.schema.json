        { "value": "warm-basalt", "label": { "zh-CN": "暖炭玄岩 · Warm Basalt（深色）", "en": "Warm Basalt (Dark)" } },
        { "value": "cool-crystal", "label": { "zh-CN": "冷晶白 · Cool Crystal（浅色）", "en": "Cool Crystal (Light)" } },
        { "value": "warm-album", "label": { "zh-CN": "暖白画册 · Warm Album（浅色）", "en": "Warm Album (Light)" } }
