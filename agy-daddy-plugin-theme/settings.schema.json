{
  "title": { "zh-CN": "视觉主题与光学定制", "en": "Visual Theme & Optics" },
  "fields": [
    {
      "key": "enabled",
      "type": "boolean",
      "default": false,
      "group": { "zh-CN": "基础与光学预设", "en": "General & Optical Presets" },
      "label": { "zh-CN": "启用视觉主题增强", "en": "Enable visual theme customization" },
      "description": {
        "zh-CN": "默认关闭，100% 保持 Antigravity 宿主原生外观；开启后按下方预设与组件配置实时注入样式，关闭即刻干净回退",
        "en": "Disabled by default to keep native Antigravity appearance untouched; enable for live hot-reloaded customization with instant clean rollback"
      }
    },
    {
      "key": "preset",
      "type": "enum",
      "default": "native",
      "visibleWhen": { "key": "enabled", "equals": true },
      "group": { "zh-CN": "基础与光学预设", "en": "General & Optical Presets" },
      "options": [
        { "value": "native", "label": { "zh-CN": "宿主原生（仅应用下方单项自定义）", "en": "Host Native (component overrides only)" } },
