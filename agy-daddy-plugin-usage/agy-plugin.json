{
  "schemaVersion": 1,
  "id": "agy-daddy.usage",
  "publisher": "agy-daddy",
  "version": "1.1.0",
  "license": "MIT",
  "displayName": {
    "zh-CN": "用量胶囊与面板",
    "en": "Usage Capsule & Panel"
  },
  "description": {
    "zh-CN": "顶栏累计用量胶囊、52 周多维度热力图、API 参考费用折算与订阅套餐管理",
    "en": "Topbar cumulative token capsule, 52-week heatmap, API equivalent cost estimator, and subscription tier config"
  },
  "engines": {
    "agyDaddy": "^1.0.0",
    "antigravity": ">=2.32.0"
  },
  "main": "./src/node.js",
  "renderer": "./src/renderer.js",
  "world": "isolated",
  "activationEvents": ["onStartup"],
  "requires": {
    "anchors": ["topbar.rightCluster"]
  },
  "provides": {
    "services": {
      "usage": { "version": "1.0.0", "realm": "node" },
      "subscription": { "version": "1.0.0", "realm": "node" }
    },
    "states": ["state:usage.summary@1"]
  },
  "consumes": {
    "context": { "version": "^1.0.0", "optional": true }
  },
  "permissions": [
    "dom:write",
    "rpc:read",
    "bridge:route",
    "fs:brain-read",
    "native:install"
  ],
  "contributes": {
    "topbar.units": [{ "id": "tokens", "order": 20 }],
    "topbar.popovers": [{ "id": "usage-panel", "anchorId": "tokens" }],
    "settings": { "schema": "./settings.schema.json" },
    "remote.panels": [{ "id": "usage", "service": "usage" }],
    "native": {
      "mcp": "./native/mcp.json"
    },
    "locales": "./locales"
  }
}
