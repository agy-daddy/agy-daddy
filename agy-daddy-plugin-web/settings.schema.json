{
  "version": 1,
  "title": {
    "en": "PC Web Harness Settings",
    "zh-CN": "PC Web 工作台设置"
  },
  "fields": [
    {
      "key": "port",
      "type": "number",
      "min": 1024,
      "max": 65535,
      "default": 18767,
      "label": {
        "en": "Listen Port",
        "zh-CN": "监听端口"
      },
      "description": {
        "en": "TCP port shared by all access channels.",
        "zh-CN": "所有访问通道共用的 TCP 端口。"
      }
    },
    {
      "key": "bindHost",
      "type": "enum",
      "default": "auto",
      "options": [
        {
          "value": "auto",
          "label": { "en": "Auto (follow enabled channels)", "zh-CN": "自动（跟随已启用通道）" }
        },
        {
          "value": "loopback",
          "label": { "en": "Force 127.0.0.1", "zh-CN": "强制 127.0.0.1" }
        },
        {
          "value": "lan",
          "label": { "en": "Force 0.0.0.0 (all interfaces)", "zh-CN": "强制 0.0.0.0（所有网卡）" }
        }
      ],
      "label": {
        "en": "Listen Address",
        "zh-CN": "监听地址"
      },
      "description": {
        "en": "Auto binds 127.0.0.1 and only widens to 0.0.0.0 when a non-loopback channel is enabled. Non-loopback binding is refused unless at least one such channel is on.",
        "zh-CN": "自动模式默认绑定 127.0.0.1，仅当启用非回环通道时才扩展到 0.0.0.0；未启用任何非回环通道时拒绝非回环绑定。"
      }
    },
    {
      "key": "loopback",
      "type": "boolean",
      "default": true,
      "label": {
        "en": "Loopback Channel (127.0.0.1)",
        "zh-CN": "本机回环通道 (127.0.0.1)"
      },
      "description": {
        "en": "Default channel. Keeps the original full read/write console on this machine.",
        "zh-CN": "默认通道，保留本机原有全读写工作台能力。"
      }
    },
    {
      "key": "lan",
      "type": "boolean",
      "default": false,
      "label": {
        "en": "LAN Channel (Wi-Fi)",
        "zh-CN": "局域网通道 (Wi-Fi)"
      },
      "description": {
        "en": "Bind all interfaces so phones/tablets on the same network can open the console. Still requires the pairing token.",
        "zh-CN": "监听所有网卡，同一 Wi-Fi 下的手机/平板可打开工作台；仍需配对 Token。"
      }
    },
    {
      "key": "tailscale",
      "type": "boolean",
      "default": false,
      "label": {
        "en": "Tailscale Channel",
        "zh-CN": "Tailscale 通道"
      },
      "description": {
        "en": "Detect Tailscale 100.64.0.0/10 and *.ts.net addresses and expose a channel entry for them.",
        "zh-CN": "识别 Tailscale 100.64.0.0/10 与 *.ts.net 地址，并提供对应通道入口。"
      }
    },
    {
      "key": "bonjour",
      "type": "boolean",
      "default": false,
      "label": {
        "en": "Bonjour Channel (.local)",
        "zh-CN": "Bonjour 通道 (.local)"
      },
      "description": {
        "en": "Advertise a <hostname>.local entry for zero-configuration LAN access.",
        "zh-CN": "提供 <主机名>.local 入口，局域网内免 IP 访问。"
      }
    },
    {
      "key": "cloudflare",
      "type": "boolean",
      "default": false,
      "label": {
        "en": "Cloudflare Tunnel Channel",
        "zh-CN": "Cloudflare Tunnel 通道"
      },
      "description": {
        "en": "Automatically shares the Cloudflare Tunnel and pairing token managed by Remote Access (agy-daddy.remote) under /pc/, with no separate hostname or second cloudflared needed; writes on this channel always require confirmation.",
        "zh-CN": "开启后自动复用「远程访问 (agy-daddy.remote)」托管的 Cloudflare 隧道与配对令牌（公网入口为 <隧道域名>/pc/），无需单独配置域名或另起 cloudflared；该通道写操作始终需要二次确认。"
      }
    },
    {
      "key": "remotePermissionLevel",
      "type": "enum",
      "default": "L0",
      "options": [
        {
          "value": "L0",
          "label": { "en": "L0 · Read-only", "zh-CN": "L0 · 只读" }
        },
        {
          "value": "L1",
          "label": { "en": "L1 · Chat & sessions", "zh-CN": "L1 · 对话与会话" }
        },
        {
          "value": "L2",
          "label": { "en": "L2 · Full workspace & host admin", "zh-CN": "L2 · 工作区与宿主管理" }
        }
      ],
      "label": {
        "en": "Non-loopback Permission Level",
        "zh-CN": "非回环通道权限级别"
      },
      "description": {
        "en": "Applies to lan/tailscale/bonjour/cloudflare only; loopback always stays full read/write. L0 = read + stream, L1 = + sessions/chat, L2 = + file write, Git, plugin and host settings.",
        "zh-CN": "仅作用于 lan/tailscale/bonjour/cloudflare，本机回环始终全读写。L0 = 只读 + 流式；L1 = 增加会话与对话；L2 = 增加文件写入、Git、插件与宿主设置。"
      }
    },
    {
      "key": "theme",
      "type": "enum",
      "default": "system",
      "options": [
        {
          "value": "system",
          "label": { "en": "Follow System", "zh-CN": "跟随系统" }
        },
        {
          "value": "dark",
          "label": { "en": "Dark", "zh-CN": "暗色模式 (Dark)" }
        },
        {
          "value": "light",
          "label": { "en": "Light", "zh-CN": "亮色模式 (Light)" }
        }
      ],
      "label": {
        "en": "Appearance Mode",
        "zh-CN": "明暗主题模式"
      }
    },
    {
      "key": "colorTheme",
      "type": "enum",
      "default": "monochrome",
      "options": [
        {
          "value": "monochrome",
          "label": { "en": "Minimal Monochrome (Native)", "zh-CN": "黑白简约（原生默认）" }
        },
        {
          "value": "purple",
          "label": { "en": "Violet Purple", "zh-CN": "紫罗兰 (Purple)" }
        },
        {
          "value": "blue",
          "label": { "en": "Cobalt Blue", "zh-CN": "钴蓝 (Blue)" }
        },
        {
          "value": "green",
          "label": { "en": "Emerald Green", "zh-CN": "翠绿 (Green)" }
        },
        {
          "value": "amber",
          "label": { "en": "Amber Gold", "zh-CN": "琥珀 (Amber)" }
        },
        {
          "value": "red",
          "label": { "en": "Crimson Red", "zh-CN": "绯红 (Red)" }
        }
      ],
      "label": {
        "en": "Color Theme Accent",
        "zh-CN": "颜色主题风格"
      }
    },
    {
      "key": "drawerSpeed",
      "type": "enum",
      "default": "normal",
      "options": [
        {
          "value": "fast",
          "label": { "en": "Fast (120ms)", "zh-CN": "快速 (120ms)" }
        },
        {
          "value": "normal",
          "label": { "en": "Balanced (200ms)", "zh-CN": "标准 (200ms)" }
        },
        {
          "value": "smooth",
          "label": { "en": "Smooth (320ms)", "zh-CN": "舒缓 (320ms)" }
        },
        {
          "value": "off",
          "label": { "en": "Instant (0ms)", "zh-CN": "无动画 (0ms)" }
        }
      ],
      "label": {
        "en": "Drawer Transition Speed",
        "zh-CN": "抽屉展开/收起动画速度"
      }
    },
    {
      "key": "allowedRoots",
      "type": "list",
      "default": [],
      "label": {
        "en": "Allowed Workspace Root Directories",
        "zh-CN": "允许访问的工作区根目录白名单"
      }
    },
    {
      "key": "autoOpenBrowser",
      "type": "boolean",
      "default": true,
      "label": {
        "en": "Auto-open Browser on Launch",
        "zh-CN": "启动时自动打开浏览器"
      }
    },
    {
      "key": "enableNotifications",
      "type": "boolean",
      "default": false,
      "group": {
        "zh-CN": "通知与提醒",
        "en": "Notifications & Alerts"
      },
      "label": {
        "zh-CN": "浏览器系统通知",
        "en": "Browser Notifications"
      },
      "description": {
        "zh-CN": "在标签页处于后台或最小化时，任务完成、后台运行结束或收到新消息时发送浏览器系统通知。",
        "en": "Show system notifications for task completions, background runs, and new messages when the tab is hidden or backgrounded."
      }
    }
  ]
}
