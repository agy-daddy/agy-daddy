{
  "name": "agy-daddy-monorepo",
  "private": true,
  "version": "1.1.1",
  "description": "Monorepo for Agy-Daddy zero-patch CDP plugin host, official plugins, registry, template, and governance tooling.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/agy-daddy/agy-daddy.git"
  },
  "engines": {
    "node": ">=22.4.0"
  },
  "scripts": {
    "build": "node scripts/monorepo.js build",
    "build:wrappers": "node scripts/build-wrappers.js",
    "verify:gates": "node scripts/monorepo.js gates",
    "test": "node scripts/monorepo.js test",
    "analyze": "node scripts/monorepo.js analyze",
    "verify": "node scripts/monorepo.js verify",
    "release:plan": "node scripts/release.js plan",
    "release:pack": "node scripts/release.js pack",
    "release:dry-run": "node scripts/release.js publish --dry-run",
    "release:healthcheck": "node scripts/release.js healthcheck --mode local"
  }
}
